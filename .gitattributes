# Media bytes under tracks/ are untracked dataset content (ADR-002): ignored
# by git, synchronized externally via rclone. Only MANIFEST.edn and the
# per-track *.json metadata are tracked.

# Rheos writes one EDN event per line and only ever appends. Union-merge keeps
# concurrent agents' events instead of forcing a conflict that loses history.
docs/kanban/.events/ledger.edn merge=union
